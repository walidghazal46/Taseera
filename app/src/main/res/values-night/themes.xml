<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Taseera.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/taseera_splash_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/taseera_splash_light</item>
        <item name="android:navigationBarColor">@color/taseera_splash_light</item>
        <item name="android:windowBackground">@color/taseera_splash_light</item>
        <item name="postSplashScreenTheme">@style/Theme.Taseera</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.Taseera" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/taseera_navy</item>
        <item name="colorPrimaryVariant">@color/taseera_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/taseera_gold</item>
        <item name="colorSecondaryVariant">@color/taseera_gold</item>
        <item name="colorOnSecondary">@color/taseera_navy_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/taseera_navy_dark</item>
        <item name="android:windowBackground">@color/taseera_navy_dark</item>
        <item name="android:windowSplashScreenBackground">@color/taseera_navy_dark</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
