rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authUid() {
      return request.auth.uid;
    }

    function authEmail() {
      return request.auth.token.email != null ? request.auth.token.email : "";
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(authUid()));
    }

    function currentUserExists() {
      return exists(/databases/$(database)/documents/users/$(authUid()));
    }

    function isSuperAdmin() {
      return isSignedIn() && authEmail() == "walidghazal46@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || (currentUserExists() && currentUserDoc().data.role == "admin"));
    }

    function hasPermission(permission) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && currentUserExists() && currentUserDoc().data.get(["permissions", permission], false) == true)
      );
    }

    function isSelf(userId) {
      return isSignedIn() && authUid() == userId;
    }

    // Fields that only admins may change on user documents.
    function touchesAdminFields() {
      return request.resource.data.role != resource.data.role ||
        request.resource.data.adminType != resource.data.adminType ||
        request.resource.data.permissions != resource.data.permissions;
    }

    // Subscription / payment fields only admins may change.
    function touchesSubscriptionFields() {
      return request.resource.data.subscriptionStatus != resource.data.subscriptionStatus ||
        request.resource.data.selectedPackage != resource.data.selectedPackage ||
        request.resource.data.packageStartDate != resource.data.packageStartDate ||
        request.resource.data.packageEndDate != resource.data.packageEndDate ||
        request.resource.data.isPaid != resource.data.isPaid ||
        request.resource.data.isActive != resource.data.isActive;
    }

    // User may not change their own role / admin / subscription / identity fields.
    function touchesPrivilegedFields() {
      return touchesAdminFields() || touchesSubscriptionFields() ||
        request.resource.data.get("status", null) != resource.data.get("status", null) ||
        request.resource.data.email != resource.data.email ||
        request.resource.data.uid != resource.data.uid;
    }

    // First-time profile creation — only "user" role allowed, email/uid must match auth.
    function creatingSelfBaseProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.uid == authUid() &&
        request.resource.data.email == authEmail() &&
        request.resource.data.role == "user";
    }

    function targetIsSuperAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.email == "walidghazal46@gmail.com";
    }

    // Valid create for a payment request (new format used by this app).
    function isValidPaymentRequestCreate() {
      return (
        request.resource.data.uid == authUid() &&
        request.resource.data.userId == authUid() &&
        request.resource.data.userCode is string &&
        request.resource.data.selectedPlan in ["monthly", "six_months", "yearly", "lifetime"] &&
        request.resource.data.amount is number &&
        request.resource.data.currency == "SAR" &&
        request.resource.data.paymentMethod in ["bank_transfer", "instapay", "cash_wallet", "stc_pay"] &&
        request.resource.data.status == "pending"
      );
    }

    // ─────────────────────────────────────────────────────
    // /users/{userId}
    // ─────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      // User creates their own profile (first login).
      allow create: if creatingSelfBaseProfile(userId) || isSuperAdmin();

      // Super Admin has full write access.
      allow write: if isSuperAdmin();

      // Normal admin can update users (cannot touch Super Admin or promote to admin).
      allow update: if isAdmin()
        && !targetIsSuperAdmin(userId)
        && !touchesAdminFields()
        && (hasPermission("editUsers") || hasPermission("suspendUsers"));

      // User can update their own non-privileged fields only.
      allow update: if isSelf(userId) && !touchesPrivilegedFields();

      allow delete: if isSuperAdmin() || (hasPermission("deleteUsers") && !targetIsSuperAdmin(userId));
    }

    // ─────────────────────────────────────────────────────
    // /systemCounters/{counterId}
    // ─────────────────────────────────────────────────────
    match /systemCounters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(["seq", "updatedAt"]) &&
        request.resource.data.seq is int;
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /paymentRequests/{requestId}
    // ─────────────────────────────────────────────────────
    match /paymentRequests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.userId == authUid() || resource.data.uid == authUid()));
      allow create: if isSignedIn() && isValidPaymentRequestCreate();
      allow update: if isAdmin() && hasPermission("approvePayments");
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /paymentSettings/{docId}
    // ─────────────────────────────────────────────────────
    match /paymentSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && hasPermission("approvePayments");
    }

    // ─────────────────────────────────────────────────────
    // /ads/{docId}
    // ─────────────────────────────────────────────────────
    match /ads/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && hasPermission("approvePayments");
    }

    // ─────────────────────────────────────────────────────
    // /adminLogs/{logId}
    // ─────────────────────────────────────────────────────
    match /adminLogs/{logId} {
      allow read: if isAdmin() && hasPermission("viewLogs");
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────
    // /countryStats/{countryId}
    // ─────────────────────────────────────────────────────
    match /countryStats/{countryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────
    // /packages/{docId}
    // ─────────────────────────────────────────────────────
    match /packages/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────────────
    // /subscriptions/{subscriptionId}
    // ─────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == authUid());
      allow create, update, delete: if isAdmin() && hasPermission("approvePayments");
    }

    // ─────────────────────────────────────────────────────
    // Deny everything else by default
    // ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
